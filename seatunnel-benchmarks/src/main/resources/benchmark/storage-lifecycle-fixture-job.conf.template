env {
  job.name = "storage-lifecycle-fixture"
  job.mode = "STREAMING"
  checkpoint.interval = {{checkpoint_interval}}
  checkpoint.timeout = 120000
  min-pause = 86400000
  parallelism = 4
}

source {
  BenchmarkSource {
    plugin_output = "storage_rows"
    total_rows = 9223372036854775807
    rate_per_second = 10000
    payload_size = 1024
    start_delay_millis = 0
    emit_batch_size = 1
  }
}

sink {
  BenchmarkSink {
    plugin_input = "storage_rows"
    result_path = "{{result_path}}"
    run_id = "{{run_id}}"
    expected_rows = 9223372036854775807
    rate_per_second = 0
    payload_size = 1024
    transform_operations = 0
  }
}
