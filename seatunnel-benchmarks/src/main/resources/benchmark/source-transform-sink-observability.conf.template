env {
  job.name = "{{job_name}}"
  job.mode = "BATCH"
  parallelism = {{parallelism}}
  engine {
    observability {
      enabled = true
      async_boundaries = ["benchmark_transform"]
      edge_buffer_capacity = 1024
    }
  }
}

source {
  BenchmarkSource {
    plugin_output = "benchmark_rows"
    parallelism = {{parallelism}}
    total_rows = {{total_rows}}
    rate_per_second = {{rate_per_second}}
    payload_size = {{payload_size}}
    start_delay_millis = {{start_delay_millis}}
    emit_batch_size = {{emit_batch_size}}
  }
}

transform {
  BenchmarkTransform {
    name = "benchmark_transform"
    plugin_input = "benchmark_rows"
    plugin_output = "transformed_rows"
    parallelism = {{parallelism}}
    operations_per_row = {{transform_operations}}
    copy_row = true
  }
}

sink {
  BenchmarkSink {
    plugin_input = "transformed_rows"
    parallelism = {{parallelism}}
    result_path = "{{result_path}}"
    run_id = "{{run_id}}"
    expected_rows = {{total_rows}}
    rate_per_second = {{rate_per_second}}
    payload_size = {{payload_size}}
    transform_operations = {{transform_operations}}
  }
}
