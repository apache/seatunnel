seatunnel:
  engine:
    backup-count: 0
    classloader-cache-mode: true
    slot-service:
      dynamic-slot: false
      slot-num: {{slot_count}}
    checkpoint:
      interval: 86400000
      timeout: 120000
      storage:
        type: hdfs
        max-retained: 20
        plugin-config:
          namespace: "{{checkpoint_storage_directory}}"
          storage.type: local
          fs.defaultFS: file:///
    telemetry:
      metric:
        enabled: false
      logs:
        scheduled-deletion-enable: false
    http:
      enable-http: false
      enable-https: false
