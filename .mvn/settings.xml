  ~
  ~ Project-scoped Maven settings. Wired automatically via .mvn/maven.config
  ~ so every `./mvnw` invocation (local dev and every CI workflow) picks
  ~ this up without per-job configuration.
  ~
  ~ Why we route Central traffic through Apache Public rather than letting
  ~ it resolve directly:
  ~   * Propagation delay: Maven Central can lag newly released Apache
  ~     artifacts (notably seatunnel-shade-*) by up to ~24h for global CDN
  ~     propagation. Apache Public receives the same releases (often
  ~     faster) and mirrors Central for everything else. Mirroring `central`
  ~     to Apache Public means CI always pulls "the newest thing available",
  ~     not "the newest thing Central has heard of".
  ~   * Apache CDN is faster than Central for most ASF-network egress.
  ~
  ~ Resolution model:
  ~   * The <mirrors> block below sends every "central" repository request
  ~     to Apache Public, so central artifacts (including Apache releases
  ~     such as seatunnel-shade-*) flow through the Apache CDN.
  ~   * Repositories declared by project/transitive POMs (e.g. testcontainers,
  ~     any third-party repo required for tests) are NOT mirrored: only
  ~     mirrorOf=central is used. This avoids dependency-confusion surprises
  ~     while still picking up freshly released shade artifacts from Apache
  ~     Public before they propagate to Central.
  ~   * Snapshot support is opt-in via `-DshadeSnapshots=true`, which
  ~     activates the `apache-snapshots` profile. Default CI builds are
  ~     release-only and pinned.
  -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 http://maven.apache.org/xsd/settings-1.0.0.xsd">

  <mirrors>
    <mirror>
      <id>apache-public-central</id>
      <name>Apache Public (mirrors Maven Central)</name>
      <url>https://repository.apache.org/content/groups/public/</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>

  <profiles>
    <profile>
      <id>apache-repo</id>
      <repositories>
        <repository>
          <id>apache-public</id>
          <url>https://repository.apache.org/content/groups/public/</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>apache-public-plugins</id>
          <url>https://repository.apache.org/content/groups/public/</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>

    <!--
      Opt-in snapshot profile: enable shade dev iteration that consumes
      seatunnel-shade-*-SNAPSHOT from Apache Public. Activate with
      `./mvnw -DshadeSnapshots=true`.
    -->
    <profile>
      <id>apache-snapshots</id>
      <activation>
        <property>
          <name>shadeSnapshots</name>
        </property>
      </activation>
      <repositories>
        <repository>
          <id>apache-public</id>
          <url>https://repository.apache.org/content/groups/public/</url>
          <releases><enabled>true</enabled></releases>
          <snapshots>
            <enabled>true</enabled>
            <updatePolicy>always</updatePolicy>
          </snapshots>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>apache-public-plugins</id>
          <url>https://repository.apache.org/content/groups/public/</url>
          <releases><enabled>true</enabled></releases>
          <snapshots>
            <enabled>true</enabled>
            <updatePolicy>always</updatePolicy>
          </snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>

  <activeProfiles>
    <activeProfile>apache-repo</activeProfile>
  </activeProfiles>
</settings>
