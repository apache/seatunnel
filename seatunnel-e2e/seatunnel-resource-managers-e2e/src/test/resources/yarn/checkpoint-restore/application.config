# checkpoint-restore scenario: fixed resources and job identity; no Java-side option overrides.
application {
  name = "seatunnel-yarn-checkpoint-restore"
  worker-count = 1
  master.memory-mb = 1024
  master.cpu-cores = 1
  worker.memory-mb = 1024
  worker.cpu-cores = 1
  worker.slots = 4
  startup-timeout-millis = 120000
  job-id = 10002
  restore-job-id = 10001
}

yarn {
  config-dir = "target/yarn-application-e2e/hadoop-conf"
  staging-dir = "/seatunnel-applications"
  distribution = "target/yarn-application-e2e/distribution-hdfs.tar.gz"
}
