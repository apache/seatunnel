application {
  name = seatunnel-yarn-local-resources
  worker-count = 2
  worker.slots = 4
}

yarn {
  distribution = target/yarn-application-e2e/distribution.tar.gz
  staging-dir = /seatunnel-applications
  job-config-file = files/job.conf
  seatunnel-config-file = files/runtime/engine.yaml
  master.hazelcast-config = hazelcast-master.yaml
  worker.hazelcast-config = hazelcast-worker.yaml
  worker.jvm-options-file = files/jvm/worker.opts

  local-resources {
    runtime {
      source-dir = target/test-classes/yarn
      localize {
        "seatunnel.yaml" = files/runtime/engine.yaml
      }
    }

    job {
      source-dir = target/test-classes/yarn/batch
      localize {
        "job.conf" = files/job.conf
      }
    }

    worker {
      content {
        "worker.opts" = "-Dyarn.test.role=inline-worker"
      }
      localize {
        "worker.opts" = files/jvm/worker.opts
      }
    }
  }
}
