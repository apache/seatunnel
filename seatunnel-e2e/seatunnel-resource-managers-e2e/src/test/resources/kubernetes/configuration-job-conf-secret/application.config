# job-conf scenario: the created Secret carries a job.conf that replaces the submitted job.
application {
  name = "seatunnel-kubernetes-job-conf-secret"
  worker-count = 1
  master.memory-mb = 768
  master.cpu-cores = 1
  worker.memory-mb = 768
  worker.cpu-cores = 1
  worker.slots = 2
  startup-timeout-millis = 180000
}

kubernetes {
  namespace = seatunnel-application-e2e
  kubeconfig = "target/kubernetes-application-e2e/kubeconfig.yaml"
  image = "seatunnel-application-e2e:local"
  image-pull-policy = Never
  service-account = application
  # The default job-config-file is <seatunnel-home>/config/job.conf; a Secret-provided file is
  # selected explicitly so no ConfigMap is needed for this scenario.
  job-config-file = /etc/seatunnel-secrets/application/job.conf

  configmap {
    runtime {
      ref = seatunnel-runtime-configuration
      mount {
        seatunnel.yaml = /opt/seatunnel/config/seatunnel.yaml
        log4j2_client.properties = /opt/seatunnel/config/log4j2_client.properties
      }
    }
  }

  secret {
    name = seatunnel-application-e2e-job-conf
    data {
      job.conf = """
        env {
          job.mode = "BATCH"
          parallelism = 1
        }

        source {
          FakeSource {
            plugin_output = "application_e2e_data"
            row.num = 2
            split.num = 2
            schema {
              fields {
                id = string
              }
            }
            rows = [
              {
                kind = INSERT
                fields = ["APPLICATION_E2E_JOB_CONF"]
              }
            ]
          }
        }

        sink {
          Console {
            plugin_input = "application_e2e_data"
          }

          Assert {
            plugin_input = "application_e2e_data"
            rules {
              row_rules = [
                {
                  rule_type = MIN_ROW
                  rule_value = 1
                }
              ]

              field_rules = [
                {
                  field_name = id
                  field_type = string
                  field_value = [
                    {
                      rule_type = NOT_NULL
                    }
                  ]
                }
              ]
            }
          }
        }
      """
    }
  }
}
