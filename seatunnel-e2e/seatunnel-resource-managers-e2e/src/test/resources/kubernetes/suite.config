# Suite environment: the disposable cluster every application-mode scenario shares. Scenario
# directories keep their own application.config for the applications they deploy.
application {
  # The suite deployer discovers a running master with this timeout.
  startup-timeout-millis = 180000
}

kubernetes {
  namespace = seatunnel-application-e2e
  kubeconfig = "target/kubernetes-application-e2e/kubeconfig.yaml"
  image = "seatunnel-application-e2e:local"
  image-pull-policy = Never
}
