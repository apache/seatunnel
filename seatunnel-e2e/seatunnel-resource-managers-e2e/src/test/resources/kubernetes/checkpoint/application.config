# checkpoint scenario: fixed resources and job identity; no Java-side option overrides.
application {
  name = "seatunnel-kubernetes-checkpoint"
  worker-count = 1
  master.memory-mb = 768
  master.cpu-cores = 1
  worker.memory-mb = 768
  worker.cpu-cores = 1
  worker.slots = 2
  startup-timeout-millis = 180000
  job-id = 10001
}

kubernetes {
  namespace = seatunnel-application-e2e
  kubeconfig = "target/kubernetes-application-e2e/kubeconfig.yaml"
  image = "seatunnel-application-e2e:local"
  image-pull-policy = Never
  service-account = application
  config-map = seatunnel-runtime-configuration
  checkpoint-pvc = application-checkpoints
}
