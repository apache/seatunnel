# job-conf scenario: a created ConfigMap carries a job.conf that replaces the submitted job.
application {
  name = "seatunnel-kubernetes-job-conf-configmap"
  worker-count = 1
  master.memory-mb = 768
  master.cpu-cores = 1
  worker.memory-mb = 768
  worker.cpu-cores = 1
  # Fixed slots must cover the job parallelism plus the split-enumerator task group: the job
  # below resolves parallelism to 2, so three slots are required.
  worker.slots = 4
  startup-timeout-millis = 180000
}

kubernetes {
  namespace = seatunnel-application-e2e
  kubeconfig = "target/kubernetes-application-e2e/kubeconfig.yaml"
  image = "seatunnel-application-e2e:local"
  image-pull-policy = Never
  service-account = application
  # Relative names resolve under <seatunnel-home>/config; the ConfigMap below mounts job.conf
  # exactly there, so no Secret permission is involved.
  job-config-file = job.conf

  # Resolved inside the Pod when the master parses the mounted job.conf.
  env.E2E_JOB_CONF_PARALLELISM = "2"

  configmap {
    runtime {
      ref = seatunnel-runtime-configuration
      mount {
        seatunnel.yaml = /opt/seatunnel/config/seatunnel.yaml
        log4j2_client.properties = /opt/seatunnel/config/log4j2_client.properties
      }
    }
    job-conf {
      name = seatunnel-application-e2e-job-conf
      data {
        job.conf = """
          env {
            job.mode = "BATCH"
            parallelism = ${E2E_JOB_CONF_PARALLELISM}
          }

          source {
            FakeSource {
              plugin_output = "application_e2e_data"
              row.num = 2
              split.num = 2
              schema {
                fields {
                  id = string
                }
              }
              rows = [
                {
                  kind = INSERT
                  fields = ["APPLICATION_E2E_JOB_CONF"]
                }
              ]
            }
          }

          sink {
            Console {
              plugin_input = "application_e2e_data"
            }

            Assert {
              plugin_input = "application_e2e_data"
              rules {
                row_rules = [
                  {
                    rule_type = MIN_ROW
                    rule_value = 1
                  }
                ]

                field_rules = [
                  {
                    field_name = id
                    field_type = string
                    field_value = [
                      {
                        rule_type = NOT_NULL
                      }
                    ]
                  }
                ]
              }
            }
          }
        """
      }
      mount {
        job.conf = /opt/seatunnel/config/job.conf
      }
    }
  }
}
