# Reference mode: the Secret and the runtime ConfigMap are managed outside SeaTunnel.
application {
  name = "seatunnel-kubernetes-configuration-ref"
  worker-count = 1
  master.memory-mb = 768
  master.cpu-cores = 1
  worker.memory-mb = 768
  worker.cpu-cores = 1
  worker.slots = 2
  startup-timeout-millis = 180000
}

kubernetes {
  namespace = seatunnel-application-e2e
  kubeconfig = "target/kubernetes-application-e2e/kubeconfig.yaml"
  image = "seatunnel-application-e2e:local"
  image-pull-policy = Never
  service-account = application

  secret-ref = seatunnel-application-e2e-ref-secret

  configmap {
    runtime {
      ref = seatunnel-runtime-configuration
      mount {
        seatunnel.yaml = /opt/seatunnel/config/seatunnel.yaml
        log4j2_client.properties = /opt/seatunnel/config/log4j2_client.properties
      }
    }
  }

  env.E2E_PARALLELISM = "secret:seatunnel-application-e2e-ref-secret/E2E_PARALLELISM"
  # Every key of the referenced Secret is injected at once, equivalent to envFrom.
  env-from.secret = seatunnel-application-e2e-ref-secret
}
