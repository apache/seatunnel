# configuration scenario: application-owned Secret, referenced and created ConfigMaps, and job
# variables resolved from the Pod environment.
application {
  name = "seatunnel-kubernetes-configuration"
  worker-count = 1
  master.memory-mb = 768
  master.cpu-cores = 1
  worker.memory-mb = 768
  worker.cpu-cores = 1
  worker.slots = 2
  startup-timeout-millis = 180000
}

kubernetes {
  namespace = seatunnel-application-e2e
  kubeconfig = "target/kubernetes-application-e2e/kubeconfig.yaml"
  image = "seatunnel-application-e2e:local"
  image-pull-policy = Never
  service-account = application
  secret-directory = /var/run/seatunnel/secrets
  master.hazelcast-config = hazelcast-master.yaml
  worker.hazelcast-config = hazelcast-worker.yaml
  seatunnel-config-file = custom/seatunnel.yaml

  secret {
    name = seatunnel-application-e2e-secret
    data {
      E2E_JOB_MODE = "BATCH"
      E2E_PARALLELISM = "1"
    }
  }

  configmap {
    runtime {
      ref = seatunnel-runtime-configuration
      mount {
        seatunnel.yaml = /opt/seatunnel/custom/seatunnel.yaml
        log4j2_client.properties = /opt/seatunnel/config/log4j2_client.properties
        hazelcast-master.yaml = /opt/seatunnel/config/hazelcast-master.yaml
        hazelcast-worker.yaml = /opt/seatunnel/config/hazelcast-worker.yaml
        jvm_master_options = /opt/seatunnel/config/jvm_master_options
        jvm_worker_options = /opt/seatunnel/config/jvm_worker_options
        jvm_options = /opt/seatunnel/config/jvm_options
      }
    }
    generated {
      name = seatunnel-application-e2e-generated
      data {
        "application-e2e.properties" = "source=kubernetes-configmap"
      }
      mount {
        "application-e2e.properties" = /opt/seatunnel/config/application-e2e.properties
      }
    }
    generated-default {
      data {
        "application-e2e-default.properties" = "source=default-name"
      }
      mount {
        "application-e2e-default.properties" = /opt/seatunnel/config/application-e2e-default.properties
      }
    }
  }

  env {
    E2E_JOB_MODE = "secret:seatunnel-application-e2e-secret/E2E_JOB_MODE"
    E2E_PARALLELISM = "secret:seatunnel-application-e2e-secret/E2E_PARALLELISM"
    E2E_CONFIG_MAP_VALUE = "configmap:seatunnel-application-e2e-generated/application-e2e.properties"
    E2E_LITERAL = "literal-value"
  }

  # Every key of the referenced ConfigMap becomes an environment variable.
  env-from.configmap = seatunnel-runtime-configuration
}
