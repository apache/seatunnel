<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.apache.seatunnel</groupId>
        <artifactId>seatunnel-e2e</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>seatunnel-resource-managers-e2e</artifactId>
    <name>SeaTunnel : E2E : Resource Managers</name>
    <properties>
        <yarn.test.include>**/e2e/yarn/**/*.java</yarn.test.include>
        <kubernetes.test.include>**/e2e/kubernetes/**/*.java</kubernetes.test.include>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.apache.seatunnel</groupId>
            <artifactId>seatunnel-resource-manager-core</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.seatunnel</groupId>
            <artifactId>seatunnel-e2e-common</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.seatunnel</groupId>
            <artifactId>seatunnel-starter</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.seatunnel</groupId>
            <artifactId>connector-fake</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.seatunnel</groupId>
            <artifactId>connector-console</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.seatunnel</groupId>
            <artifactId>connector-assert</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.seatunnel</groupId>
            <artifactId>seatunnel-shade-hadoop3-uber</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.seatunnel</groupId>
            <artifactId>seatunnel-resource-manager-yarn</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-minicluster</artifactId>
            <version>${seatunnel.shade.hadoop.version}</version>
            <scope>test</scope>
            <exclusions>
                <!-- Kubernetes client 19.0.1 requires Gson 2.10.1; Hadoop 3.1.4 brings 2.2.4. -->
                <exclusion>
                    <groupId>com.google.code.gson</groupId>
                    <artifactId>gson</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <!-- Hadoop MiniYARNCluster's JAXB web application needs this API on Java 11+. -->
            <groupId>javax.activation</groupId>
            <artifactId>javax.activation-api</artifactId>
            <version>1.2.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.seatunnel</groupId>
            <artifactId>seatunnel-resource-manager-kubernetes</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>k3s</artifactId>
            <version>${testcontainer.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.kubernetes</groupId>
            <artifactId>client-java</artifactId>
            <version>19.0.1</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>com.squareup.okhttp3</groupId>
                    <artifactId>okhttp</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.squareup.okhttp3</groupId>
                    <artifactId>logging-interceptor</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>stage-resource-manager-e2e-dependencies</id>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <phase>process-test-resources</phase>
                        <configuration>
                            <skip>false</skip>
                            <overWriteReleases>true</overWriteReleases>
                            <overWriteSnapshots>true</overWriteSnapshots>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.apache.seatunnel</groupId>
                                    <artifactId>seatunnel-starter</artifactId>
                                    <version>${project.version}</version>
                                    <destFileName>seatunnel-starter.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.apache.seatunnel</groupId>
                                    <artifactId>connector-fake</artifactId>
                                    <version>${project.version}</version>
                                    <destFileName>connector-fake.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.apache.seatunnel</groupId>
                                    <artifactId>connector-console</artifactId>
                                    <version>${project.version}</version>
                                    <destFileName>connector-console.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.apache.seatunnel</groupId>
                                    <artifactId>connector-assert</artifactId>
                                    <version>${project.version}</version>
                                    <destFileName>connector-assert.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.apache.seatunnel</groupId>
                                    <artifactId>seatunnel-shade-hadoop3-uber</artifactId>
                                    <version>${seatunnel.shade.hadoop.version}-${seatunnel.shade.version}</version>
                                    <destFileName>seatunnel-shade-hadoop3-uber.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${project.build.testOutputDirectory}/e2e-dependencies</outputDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>stage-yarn-e2e-provider</id>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <phase>process-test-resources</phase>
                        <configuration>
                            <skip>false</skip>
                            <overWriteReleases>true</overWriteReleases>
                            <overWriteSnapshots>true</overWriteSnapshots>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.apache.seatunnel</groupId>
                                    <artifactId>seatunnel-resource-manager-yarn</artifactId>
                                    <version>${project.version}</version>
                                    <destFileName>seatunnel-resource-manager-yarn.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${project.build.testOutputDirectory}/e2e-dependencies</outputDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>stage-kubernetes-e2e-provider</id>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <phase>process-test-resources</phase>
                        <configuration>
                            <skip>false</skip>
                            <overWriteReleases>true</overWriteReleases>
                            <overWriteSnapshots>true</overWriteSnapshots>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.apache.seatunnel</groupId>
                                    <artifactId>seatunnel-resource-manager-kubernetes</artifactId>
                                    <version>${project.version}</version>
                                    <destFileName>seatunnel-resource-manager-kubernetes.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${project.build.testOutputDirectory}/e2e-dependencies</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <testIncludes>
                        <testInclude>**/e2e/common/**/*.java</testInclude>
                        <testInclude>${yarn.test.include}</testInclude>
                        <testInclude>${kubernetes.test.include}</testInclude>
                    </testIncludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>${surefire.jvm.args} -Xmx2048m</argLine>
                    <!-- MiniCluster uses upstream test jars; exclude the relocated runtime API. -->
                    <classpathDependencyExcludes combine.children="append">
                        <classpathDependencyExclude>org.apache.seatunnel:seatunnel-shade-hadoop3-uber</classpathDependencyExclude>
                        <!-- The staged fat jar contains unshaded Jetty classes; worker JVMs load it from the archive. -->
                        <classpathDependencyExclude>org.apache.seatunnel:seatunnel-starter</classpathDependencyExclude>
                    </classpathDependencyExcludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <argLine>${surefire.jvm.args} -Xmx2048m</argLine>
                    <includes>
                        <include>${yarn.test.include}</include>
                        <include>${kubernetes.test.include}</include>
                    </includes>
                    <classpathDependencyExcludes combine.children="append">
                        <classpathDependencyExclude>org.apache.seatunnel:seatunnel-shade-hadoop3-uber</classpathDependencyExclude>
                        <classpathDependencyExclude>org.apache.seatunnel:seatunnel-starter</classpathDependencyExclude>
                    </classpathDependencyExcludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
