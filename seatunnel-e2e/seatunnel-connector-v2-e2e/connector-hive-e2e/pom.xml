<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.apache.seatunnel</groupId>
        <artifactId>seatunnel-connector-v2-e2e</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>connector-hive-e2e</artifactId>
    <name>SeaTunnel : E2E : Connector V2 : Hive</name>

    <properties>
        <hive.version>3.1.3</hive.version>
        <thrift.version>0.9.3</thrift.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.seatunnel</groupId>
            <artifactId>connector-fake</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.seatunnel</groupId>
            <artifactId>connector-assert</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.seatunnel</groupId>
            <artifactId>connector-hive</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.seatunnel</groupId>
            <artifactId>seatunnel-hadoop3-3.4.3-uber</artifactId>
            <version>${project.version}</version>
            <classifier>optional</classifier>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>log4j</groupId>
                    <artifactId>log4j</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.hive</groupId>
            <artifactId>hive-jdbc</artifactId>
            <version>${hive.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>log4j</groupId>
                    <artifactId>log4j</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-web</artifactId>
                </exclusion>
                <!-- Exclude Guava to avoid version conflicts -->
                <exclusion>
                    <groupId>com.google.guava</groupId>
                    <artifactId>guava</artifactId>
                </exclusion>
                <!-- Exclude other potential conflict dependencies -->
                <exclusion>
                    <groupId>org.apache.parquet</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.orc</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Add Hive MetaStore dependency for E2E tests -->
        <dependency>
            <groupId>org.apache.hive</groupId>
            <artifactId>hive-metastore</artifactId>
            <version>${hive.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>log4j</groupId>
                    <artifactId>log4j</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <!-- Exclude Guava to avoid version conflicts -->
                <exclusion>
                    <groupId>com.google.guava</groupId>
                    <artifactId>guava</artifactId>
                </exclusion>
                <!-- Exclude other potential conflict dependencies -->
                <exclusion>
                    <groupId>org.apache.parquet</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.orc</groupId>
                    <artifactId>*</artifactId>
                </exclusion>

            </exclusions>
        </dependency>

        <!-- Add Thrift dependency for E2E tests (align with Hive 3.1.3) -->
        <dependency>
            <groupId>org.apache.thrift</groupId>
            <artifactId>libthrift</artifactId>
            <version>${thrift.version}</version>
            <scope>test</scope>
        </dependency>

        <!--
            HiveDependencies copies seatunnel-hadoop-aws.jar into the container, which is where a
            real distribution carries S3A. The jar is staged into the test classpath by the
            maven-dependency-plugin execution below; this dependency is what makes
            `-pl :connector-hive-e2e -am` build it in the same reactor, so that staging resolves.
            The jar is only ever read from the filesystem, never linked against here, so its
            transitive hadoop-aws and AWS SDK are excluded.
        -->
        <dependency>
            <groupId>org.apache.seatunnel</groupId>
            <artifactId>seatunnel-hadoop-aws</artifactId>
            <version>${project.version}</version>
            <classifier>optional</classifier>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-hive-e2e-dependencies</id>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <phase>process-test-resources</phase>
                        <configuration>
                            <skip>false</skip>
                            <overWriteReleases>true</overWriteReleases>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.apache.hive</groupId>
                                    <artifactId>hive-exec</artifactId>
                                    <version>${hive.version}</version>
                                    <destFileName>hive-exec.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.apache.thrift</groupId>
                                    <artifactId>libfb303</artifactId>
                                    <version>${thrift.version}</version>
                                    <destFileName>libfb303.jar</destFileName>
                                </artifactItem>
                                <!--
                                    S3A reaches the container as the shaded seatunnel-hadoop-aws
                                    jar, which is what lib/seatunnel-hadoop-aws.jar is in a real
                                    distribution: it carries hadoop-aws together with the AWS SDK
                                    version hadoop-aws is compiled against. Staging hadoop-aws on
                                    its own, as this did before, leaves the container without any
                                    AWS SDK at all.
                                -->
                                <artifactItem>
                                    <groupId>org.apache.seatunnel</groupId>
                                    <artifactId>seatunnel-hadoop-aws</artifactId>
                                    <version>${project.version}</version>
                                    <classifier>optional</classifier>
                                    <destFileName>seatunnel-hadoop-aws.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.aliyun.oss</groupId>
                                    <artifactId>aliyun-sdk-oss</artifactId>
                                    <version>${aliyun.sdk.oss.version}</version>
                                    <destFileName>aliyun-sdk-oss.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.jdom</groupId>
                                    <artifactId>jdom2</artifactId>
                                    <version>${jdom2.version}</version>
                                    <destFileName>jdom2.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.apache.hadoop</groupId>
                                    <artifactId>hadoop-aliyun</artifactId>
                                    <version>${hadoop-aliyun.version}</version>
                                    <destFileName>hadoop-aliyun.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.qcloud.cos</groupId>
                                    <artifactId>hadoop-cos</artifactId>
                                    <version>${hadoop-cos.version}</version>
                                    <destFileName>hadoop-cos.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${project.build.testOutputDirectory}/e2e-dependencies</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
