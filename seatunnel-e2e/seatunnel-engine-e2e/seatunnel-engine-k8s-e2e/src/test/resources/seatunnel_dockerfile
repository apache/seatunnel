# The build now targets Java 11 bytecode, so the pod JVM must be at least Java 11.
# A full JDK is kept because the engine e2e helpers inspect the running server with jps/jstack.
FROM eclipse-temurin:11-jdk
ENV SEATUNNEL_HOME="/opt/seatunnel"
COPY /jars/seatunnel-shade-hadoop3-uber.jar ${SEATUNNEL_HOME}/lib/seatunnel-shade-hadoop3-uber.jar
COPY /jars/seatunnel-transforms-v2.jar ${SEATUNNEL_HOME}/lib/seatunnel-transforms-v2.jar
COPY /jars/seatunnel-starter.jar ${SEATUNNEL_HOME}/starter/seatunnel-starter.jar
COPY /bin ${SEATUNNEL_HOME}/bin
COPY /connectors ${SEATUNNEL_HOME}/connectors
COPY /config ${SEATUNNEL_HOME}/config
RUN  mkdir -p ${SEATUNNEL_HOME}/logs
WORKDIR /opt/seatunnel


