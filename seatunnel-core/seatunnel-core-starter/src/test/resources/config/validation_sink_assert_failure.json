{
  "env": {
    "parallelism": 1,
    "job.mode": "BATCH"
  },
  "source": [
    {
      "plugin_name": "FakeSource",
      "plugin_output": "fake_table",
      "row.num": 10,
      "schema": {
        "fields": {
          "name": "string",
          "age": "int"
        }
      }
    }
  ],
  "transform": [],
  "sink": [
    {
      "plugin_name": "InMemory",
      "plugin_input": "fake_table",
      "assert_options_key": "left",
      "assert_options_value": "right"
    }
  ]
}
