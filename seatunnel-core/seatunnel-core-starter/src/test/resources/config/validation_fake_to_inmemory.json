{
  "env": {
    "parallelism": 1,
    "job.mode": "BATCH"
  },
  "source": [
    {
      "plugin_name": "FakeSource",
      "plugin_output": "fake_table",
      "row.num": 10,
      "schema": {
        "fields": {
          "name": "string",
          "age": "int"
        }
      }
    }
  ],
  "transform": [
    {
      "plugin_name": "Filter",
      "plugin_input": "fake_table",
      "plugin_output": "filtered_table",
      "include_fields": ["name"]
    }
  ],
  "sink": [
    {
      "plugin_name": "InMemory",
      "plugin_input": "filtered_table"
    }
  ]
}
