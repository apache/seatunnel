# Deployment settings; use a separate job file with --config.
# Replace platform paths/image and prepare permissions before submission.
application {
  name = "example-batch"
  worker-count = 2
  worker {
    memory-mb = 1024
    cpu-cores = 1
    slots = 4
  }
  master {
    memory-mb = 1024
    cpu-cores = 1
    port = 5801
  }
  startup-timeout-millis = 180000
}

kubernetes {
  namespace = "seatunnel"
  image = "your-registry/seatunnel-application:<version>"
  service-account = "seatunnel-application"
  image-pull-policy = "IfNotPresent"
  seatunnel-home = "/opt/seatunnel"
  finished-job-retention-seconds = 86400
}
