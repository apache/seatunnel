# Minimal deployment file. Pair it with a job file, for example the bundled batch template:
#   bin/seatunnel-application.sh submit -t kubernetes -c config/v2.batch.config.template -a kubernetes.conf
# Secret, ConfigMap, environment and runtime-file options are documented in
# docs/en/getting-started/application/kubernetes/configuration.md.
application {
  name = "example-batch"
  # The bundled batch template runs two source tasks plus the split enumerator.
  worker-count = 2
}

kubernetes {
  namespace = "seatunnel"
  image = "your-registry/seatunnel-application:<version>"
  # ServiceAccount and RBAC as described in the Kubernetes quick start.
  service-account = "seatunnel-application"
  # Optional: tolerate tainted node pools. Entries are key[=value][:Effect] separated by ';'.
  # master.tolerations = "dedicated=seatunnel:NoSchedule"
  # worker.tolerations = "dedicated=seatunnel:NoSchedule"
}
